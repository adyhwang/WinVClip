<UserControl x:Class="WinVClip.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ControlTemplate x:Key="StepButtonTemplate" TargetType="RepeatButton">
            <Border Background="Transparent" CornerRadius="3" Padding="4,1"
                    TextElement.Foreground="{DynamicResource SecondaryTextForeground}">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource InputBackground}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ValueTextBox" Grid.Column="0"
                     BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextForeground}"
                     VerticalAlignment="Center" HorizontalContentAlignment="Center"
                     Padding="6,4"
                     LostFocus="ValueTextBox_LostFocus"
                     KeyDown="ValueTextBox_KeyDown"/>
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,4,0">
                <RepeatButton x:Name="UpButton" Template="{StaticResource StepButtonTemplate}"
                              Click="UpButton_Click" Delay="350" Interval="120"
                              Focusable="False" Cursor="Hand">
                    <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                </RepeatButton>
                <RepeatButton x:Name="DownButton" Template="{StaticResource StepButtonTemplate}"
                              Click="DownButton_Click" Delay="350" Interval="120"
                              Focusable="False" Cursor="Hand">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                </RepeatButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
