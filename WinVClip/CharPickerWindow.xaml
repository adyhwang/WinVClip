<Window x:Class="WinVClip.CharPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CharPicker" 
        Height="500" 
        Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InsertButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="8,8,0,0"
                    Height="40"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="InsertButton"
                                Content="插入"
                                Style="{StaticResource InsertButtonStyle}"
                                VerticalAlignment="Center"
                                Click="InsertButton_Click"/>
                        <CheckBox x:Name="SelectAllCheckBox"
                                     Content="全选"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextForeground}"
                                     Checked="SelectAllCheckBox_Checked"
                                     Unchecked="SelectAllCheckBox_Unchecked"/>
                        <Button x:Name="InvertButton"
                                Content="⇄"
                                Width="30"
                                Height="30"
                                Margin="5,0,0,0"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="反选"
                                Click="InvertButton_Click"/>
                        <Button x:Name="CopyButton"
                                Content="📋"
                                Width="30"
                                Height="30"
                                Margin="5,0,0,0"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="复制"
                                Click="CopyButton_Click"/>
                        <Button x:Name="SearchButton"
                                Content="🔍"
                                Width="30"
                                Height="30"
                                IsEnabled="False"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="搜索"
                                Click="SearchButton_Click"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 待插入文字区 -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource ItemBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedTextLabel"
                               Grid.Row="0" 
                               Text="待插入文字:" 
                               Foreground="{DynamicResource SecondaryTextForeground}"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <Border Grid.Row="1"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <TextBlock x:Name="SelectedTextBlock"
                                   Text=""
                                   Foreground="{DynamicResource TextForeground}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxHeight="60"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 单字显示区 -->
            <ScrollViewer Grid.Row="2" 
                          x:Name="CharScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="15"
                          Background="{DynamicResource WindowBackground}">
                <WrapPanel x:Name="CharWrapPanel"
                           Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
